        },
        {
            "m_Id": "e44e1e86e8d14b6db327ff3b657c05a9"
        },
        {
            "m_Id": "f52f5149af12499ca4a965b64f2df564"
        },
        {
            "m_Id": "182c4f60b5d548f59eaaf1d92004718e"
        },
        {
            "m_Id": "66e8ab97faac449385cb783a836f1c9e"
        },
        {
            "m_Id": "0d704fdeff8d405280f71b87c4c62fc4"
        },
        {
            "m_Id": "18de209d1edd4f759c89a86c0441f003"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PolyhydraColor",
    "m_FunctionSource": "",
    "m_FunctionBody": "float gray = dot(VertexColor.rgb, float3(0.299, 0.587, 0.114));\nfloat3 color = lerp(gray.xxx, VertexColor.rgb, Saturation);\nAlbedo = Texture.rgb * Tint.rgb * color;\nSpecular = color;\nAlpha = Texture.a * Tint.a;"
}

